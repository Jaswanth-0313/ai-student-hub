STUDY_AI_API_KEY=your-openai-compatible-api-key
STUDY_AI_MODEL=gpt-4o-mini
STUDY_AI_BASE_URL=https://api.openai.com/v1
# Copy this file to .env and fill values for production

# MongoDB connection string (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-student-hub?retryWrites=true&w=majority

# JWT signing secret (store a 64-byte hex string)
JWT_SECRET=replace_with_a_strong_random_secret

# Port for the server (Render sets automatically)
PORT=5000

# Comma-separated allowed origins for CORS (e.g. https://your-app.onrender.com)
CORS_ORIGIN=https://your-app.onrender.com

# Frontend URL used for redirects (set to your dev frontend when developing)
FRONTEND_URL=http://localhost:5173

# Google OAuth credentials - create these in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/users/google/callback

# Optional: base URL for server
BASE_URL=http://localhost:5000

# SMTP for sending password reset emails (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=AI Student Hub <no-reply@example.com>

# Admin account used for emergency recovery/rotation
# Set these to an email and a strong temporary password; change immediately
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMeNow!#2026

# Use Docker-based isolated runner for Dev-C++ compile (recommended for production)
# Set to 'true' to run compilation inside the docker image instead of the host
USE_DOCKER_RUNNER=false
# Docker image name to use/build
DOCKER_RUNNER_IMAGE=ai-student-hub-devcpp
